{
  "name": "cline-automation-framework",
  "version": "1.0.0",
  "description": "AI‑first Playwright BDD automation framework built for Cline",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --config eslint.config.js",
    "format": "prettier --write .",
    "test": "cucumber-js",
    "test:bdd": "cucumber-js",
    "test:a3": "cucumber-js --tags '@A3'",
    "test:smoke": "cucumber-js --tags '@smoke'",
    "test:ci": "cucumber-js --tags '@ci and not @known-bug'",
    "test:dry": "cucumber-js --dry-run",
    "test:regression": "cucumber-js --tags '@regression'",
    "test:known-issues": "cucumber-js --tags '@known-bug'",
    "test:passing": "cucumber-js --tags 'not @known-bug'",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "cucumber",
    "bdd",
    "automation",
    "cline"
  ],
  "author": "Generated by Cline Documentation Agent",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.1",
    "husky": "^9.0.0",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
